{
  "name": "dsh-model-orchestrator",
  "version": "2.5.0",
  "type": "module",
  "description": "两级模型调度：先在模型层选最优模型，再在渠道层选该模型的最佳渠道；失败先换渠道再换模型。新会话第一条消息就按调度结果调用模型，可选「自动选择」让官方选择器只作展示，偏好模式下锁定一个模型、用尽所有渠道后才降级并提醒；实时显示额度、健康与用量。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "src",
    "tools",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:data": "node tools/build-data.mjs",
    "check": "node --check index.js && node --check client.js && node tools/smoke.mjs && node tools/integration.mjs && node tools/client-smoke.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm-router",
    "model-failover",
    "quota"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeZhou123/dsh-model-orchestrator.git"
  },
  "homepage": "https://github.com/DeZhou123/dsh-model-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/DeZhou123/dsh-model-orchestrator/issues"
  },
  "license": "MIT"
}
